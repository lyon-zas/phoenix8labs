{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phoenix8labs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker; every other request is served straight from the static export.
    "run_worker_first": ["/api/*"]
  },
  // Used by `wrangler preview` (branch preview builds). Public Turnstile site key only; secrets
  // (TURNSTILE_SECRET, RESEND_API_KEY) are set in the Cloudflare dashboard, never here.
  "previews": {
    "vars": {
      "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFOGRaATLwKkudjf"
    }
  }
}
