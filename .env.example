# Public (baked into the static build at build time). Get from Cloudflare > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secrets for the Pages Function (functions/api/contact.ts).
# Set these in Cloudflare Pages > Settings > Environment variables. For local `wrangler pages dev`, copy to .dev.vars.
TURNSTILE_SECRET=
RESEND_API_KEY=

# Optional overrides
# CONTACT_TO=hello@phoenix8labs.com
# CONTACT_FROM=Phoenix 8 Labs <noreply@phoenix8labs.com>
